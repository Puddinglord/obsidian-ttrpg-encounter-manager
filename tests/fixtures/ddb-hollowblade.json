		"classes": [
			{
				"id": 5001,
				"entityTypeId": 1446578651,
				"level": 7,
				"isStartingClass": true,
				"hitDiceUsed": 1,
				"definitionId": 900001,
				"subclassDefinitionId": 900101,
				"definition": {
					"id": 900001,
					"definitionKey": "class:900001",
					"name": "Hollowblade",
					"description": "<p>Hollowblades are wardens who fight with a blade that hums with an empty note.</p><h4>Core Hollowblade Traits</h4><table><tbody><tr><th>Primary Ability</th><td>Strength and Intelligence</td></tr><tr><th>Hit Point Die</th><td>D10 per Hollowblade level</td></tr><tr><th>Saving Throw Proficiencies</th><td>Strength and Intelligence</td></tr><tr><th>Skill Proficiencies</th><td><em>Choose 2:</em> Arcana, Athletics, Insight, Investigation, Perception, or Survival</td></tr><tr><th>Weapon Proficiencies</th><td>Simple and Martial weapons</td></tr><tr><th>Armor Training</th><td>Light and Medium armor and Shields</td></tr><tr><th>Starting Equipment</th><td><em>Choose A or B:</em> (A) Scale Mail, Shield, Longsword, 2 Dagger, and 12 GP; or (B) 160 GP</td></tr></tbody></table>",
					"equipmentDescription": "",
					"parentClassId": null,
					"spellCastingAbilityId": null,
					"canCastSpells": false,
					"hitDice": 10,
					"primaryAbilities": [
						1,
						4
					],
					"isHomebrew": false,
					"sources": [
						{
							"sourceId": 99001,
							"pageNumber": null,
							"sourceType": 1
						}
					],
					"classFeatures": [
						{
							"id": 910001,
							"name": "Core Hollowblade Traits",
							"prerequisite": null,
							"description": "<p>You gain the traits in the Core Hollowblade Traits table.</p>",
							"requiredLevel": 1,
							"displayOrder": 1
						},
						{
							"id": 910002,
							"name": "Hollow Strike",
							"prerequisite": null,
							"description": "<p>When you hit a creature with a melee weapon, you can ring your blade: the target takes an extra Hollow die of Force damage. The die is shown in the Hollow Die column of the Hollowblade table.</p>",
							"requiredLevel": 1,
							"displayOrder": 1
						},
						{
							"id": 910003,
							"name": "Grave Sense",
							"prerequisite": null,
							"description": "<p>As a Bonus Action, you sense the undead within 60 feet of you until the end of your next turn.</p><p>You can use this feature a number of times shown in the Grave Sense column of the Hollowblade table, and you regain all expended uses when you finish a Long Rest.</p>",
							"requiredLevel": 1,
							"displayOrder": 1
						},
						{
							"id": 910004,
							"name": "Ashen Step",
							"prerequisite": null,
							"description": "<p>When you take the Dash action, you can leave a trail of cold ash. You can use this feature a number of times equal to your Proficiency Bonus, and you regain all expended uses when you finish a Long Rest.</p>",
							"requiredLevel": 2,
							"displayOrder": 2
						},
						{
							"id": 910005,
							"name": "Hollowblade Order",
							"prerequisite": null,
							"description": "<p>You join a Hollowblade order, a subclass of your choice. You gain each of its features at the levels it lists.</p>",
							"requiredLevel": 3,
							"displayOrder": 3
						},
						{
							"id": 910006,
							"name": "Ability Score Improvement",
							"prerequisite": null,
							"description": "<p>You gain the Ability Score Improvement feat or another feat of your choice for which you qualify.</p>",
							"requiredLevel": 4,
							"displayOrder": 4
						},
						{
							"id": 910007,
							"name": "Extra Attack",
							"prerequisite": null,
							"description": "<p>You can attack twice instead of once whenever you take the Attack action on your turn.</p>",
							"requiredLevel": 5,
							"displayOrder": 5
						},
						{
							"id": 910008,
							"name": "Lantern Ward",
							"prerequisite": null,
							"description": "<p>You and allies within 10 feet of you have Advantage on saving throws against the <strong>Frightened</strong> condition.</p>",
							"requiredLevel": 6,
							"displayOrder": 6
						},
						{
							"id": 910009,
							"name": "Order Feature",
							"prerequisite": null,
							"description": "<p>You gain a feature from your Hollowblade order.</p>",
							"requiredLevel": 7,
							"displayOrder": 7
						}
					],
