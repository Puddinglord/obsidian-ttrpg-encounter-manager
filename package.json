{
	"name": "nimble-gm",
	"version": "1.0.0",
	"description": "Run Nimble TTRPG games from your notes: campaigns, a bundled bestiary, encounter blocks rated for your party, a combat tracker, GM maps and 3D dice.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"deploy": "./deploy.sh",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run",
		"test:e2e": "npm run build && node e2e/run.mjs",
		"lint": "eslint .",
		"screenshots": "npm run build && node e2e/screenshots.mjs"
	},
	"keywords": [],
	"author": "Dakotah",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@types/node": "^22.20.5",
		"@types/three": "^0.170.0",
		"cannon-es": "^0.20.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.5.0",
		"happy-dom": "^21.0.4",
		"obsidian": "latest",
		"playwright-core": "^1.64.1",
		"three": "^0.170.0",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.1.0"
	}
}
